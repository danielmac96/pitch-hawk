# Pitch Hawk environment. Copy to .env for local work: the modeling
# workbench (modeling/), the R2 warehouse (warehouse/) and the QA dashboard.
# Production runs on Supabase; the values that live in the DB (app_secrets)
# rather than env are noted at the bottom.

# ── Supabase connection (modeling/, warehouse/) ───────────────────────────
# Project API URL and a key. Reads (public data) work with the anon/
# publishable key; writes to model_params, the display aggregates and the
# holdout export need the service_role key.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_KEY=<service_role-or-anon-key>

# Frontend build (scripts/build_frontend.sh). If unset it defaults to this
# project's functions URL; set empty to force sample-data demo mode.
SUPABASE_FUNCTIONS_URL=https://<ref>.supabase.co/functions/v1

# ── Cloudflare R2 warehouse (warehouse/, modeling/, dashboard/) ────────────
# The historical Parquet warehouse. All four are required; warehouse.config
# .r2_config() raises if any is missing. The same four exist as GitHub Actions
# repository secrets for the nightly workflow.
#
# R2_BUCKET must be exactly `pitch-hawk-warehouse`. A wrong bucket name is not
# a loud failure on its own — R2 returns 403 on every object rather than 404 —
# so R2Store now probes the bucket at construction and raises. Historically a
# typo here made manifest.load() return an EMPTY manifest, and the warehouse
# looked empty rather than unreachable.
#
# The token is scoped Object Read & Write with NO list permission: ListObjectsV2
# and ListBuckets both return AccessDenied. Readers resolve keys through
# _manifest.json, never by listing. `aws s3 ls` will tell you the bucket is
# empty. It is not.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=pitch-hawk-warehouse

# ── Supabase Management API (scripts, migrations) ──────────────────────────
# A personal access token, `sbp_` prefix — NOT a project key. The Supabase MCP
# server's --access-token wants this one; handing it an `sb_secret_` project
# key fails with a bare "Unauthorized".
SUPABASE_ACCESS_TOKEN=sbp_<personal-access-token>

# ── Values stored in Supabase app_secrets (NOT env) ────────────────────────
# Set via SQL / MCP execute_sql, never exposed to the API (RLS, no policy):
#   cron_secret          shared secret pg_cron sends as x-cron-secret
#   functions_base_url    https://<ref>.supabase.co/functions/v1
#   allowed_origins       comma-separated CORS allowlist for the api function
#                         (e.g. https://pitch-hawk.vercel.app); "*" until set
#   season_start          backfill window start (YYYY-MM-DD); defaults to
#                         <year>-03-15 when absent
#   the_odds_api_key      activates the The Odds API provider in odds-ingest
#   SPORTSBOOK_AFF_*      per-book affiliate params, if/when monetized
