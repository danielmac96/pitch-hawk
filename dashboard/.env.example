# QA dashboard — Cloudflare R2 credentials.
#
# Copy to `dashboard/.env`, or skip this file entirely: the app also loads the
# repo-root `.env`, which already carries these four for the pipeline. A value
# already exported into the environment wins over both.
#
# All four are required. `warehouse.config.r2_config()` raises if any is
# missing, and the dashboard renders that as "Unable to connect to Cloudflare
# R2." rather than a traceback.
#
# R2_BUCKET must name the warehouse bucket exactly. A wrong name is not a loud
# failure on its own — R2 answers HTTP 403 on every object rather than 404 — so
# the store head-buckets at startup and the dashboard reports it.
#
# The token is scoped Object Read & Write with no LIST permission:
# ListObjectsV2 returns AccessDenied. The dashboard therefore resolves every
# file through `_manifest.json` and never lists the bucket. Read access is all
# it needs; it writes nothing.

R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=pitch-hawk-warehouse
